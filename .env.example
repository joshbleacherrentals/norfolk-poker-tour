# Copy to .env for local development (`cp .env.example .env`).
# These defaults match `supabase start` — see `npm run db:status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SESSION_SECRET=change-me-locally

# macOS uses port 5000 for AirPlay Receiver, so default to 5001 locally.
PORT=5001

# Hosted Supabase: use the pooler connection string from
# Project Settings -> Database -> Connection string (include ?sslmode=require).
